<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0">
  <kcfgfile name=""/>
  <group name="General">
    <!-- Disco que muestra esta instancia: letra|nombre|origen.
         origen = punto de montaje, partición /dev/... o el disco entero por /dev/disk/by-id/
         (no el nombre nvme0/nvme1, que el kernel cambia de arranque). -->
    <entry name="disk" type="String"><default>S|Sistema|/</default></entry>
    <!-- PARTUUID de la partición que dibuja el gráfico. Vacío = la de origen. -->
    <entry name="graphPart" type="String"><default></default></entry>
    <!-- Porcentaje libre por debajo del cual el relleno pasa a ámbar / rojo -->
    <entry name="warnPercent" type="Int"><default>20</default></entry>
    <entry name="critPercent" type="Int"><default>10</default></entry>
    <!-- Porcentaje de actividad a partir del cual el anillo pasa a amarillo / rojo -->
    <entry name="busyWarn" type="Int"><default>50</default></entry>
    <entry name="busyCrit" type="Int"><default>80</default></entry>
  </group>
</kcfg>
